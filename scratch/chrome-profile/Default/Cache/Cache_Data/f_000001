<script>
    $(document).ready(function() {
        // Make the entire product card clickable
        $(document).on('click', '.product-box', function(e) {
            // Ignore if clicked on Add to Cart button, Quick View wrapper, or other explicit links
            if ($(e.target).closest('.product-card-btn, .cart-info, a, button').length) {
                return;
            }
            // Find the detail page link
            var link = $(this).find('a[href*="/Items/ItemDetails"]').first();
            if (link.length) {
                var url = link.attr('href');
                if (url) {
                    window.location.href = url;
                }
            }
        });
    });

    function openSearch() {
        document.getElementById('search-overlay').style.display = 'block';
        var input = document.getElementById('search-overlay').querySelector('input');
        if (input) {
            if (typeof ClsItems !== 'undefined' && ClsItems.currentSearch) {
                input.value = ClsItems.currentSearch;
            }
            input.focus();
        }
    }
    function closeSearch() {
        document.getElementById('search-overlay').style.display = 'none';
    }
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeSearch();
            var menu = document.getElementById('accountMenu');
            if (menu) menu.style.display = 'none';
        }
    });
    // Account dropdown - click based
    function toggleAccountMenu() {
        var menu = document.getElementById('accountMenu');
        if (menu.style.display === 'none' || menu.style.display === '') {
            menu.style.display = 'block';
        } else {
            menu.style.display = 'none';
        }
    }
    // Close account menu when clicking outside
    document.addEventListener('click', function(e) {
        var dropdown = document.getElementById('accountDropdown');
        var menu = document.getElementById('accountMenu');
        if (dropdown && menu && !dropdown.contains(e.target)) {
            menu.style.display = 'none';
        }
    });
    function AddToCartAjax(itemId, btn) {
        Helper.AjaxCallGet("/Order/AddToCartAjax?itemId=" + itemId, {}, "json", function(response) {
            if (response && response.success) {
                var badge = $('#cartCountBadge');
                if (badge.length) {
                    badge.text(response.cartCount);
                    badge.show();
                }
                
                // Fly-to-Cart Animation
                if (btn) {
                    var img = $(btn).closest('.product-box').find('.img-wrapper img');
                    if (img.length === 0) {
                        img = $('.product-right-slick img').first();
                    }
                    if (img.length === 0) {
                        img = $(btn).closest('.product-form-box').closest('.row').find('.product-right-slick img').first();
                    }
                    if (img.length > 0) {
                        var cart = $('#cartCountBadge');
                        if (!cart.length || cart.css('display') === 'none') {
                            cart = $('.fa-shopping-cart').first();
                        }
                        if (cart.length > 0) {
                            var imgClone = img.clone()
                                .offset({
                                    top: img.offset().top,
                                    left: img.offset().left
                                })
                                .css({
                                    'opacity': '0.8',
                                    'position': 'absolute',
                                    'height': img.height() + 'px',
                                    'width': img.width() + 'px',
                                    'z-index': '99999',
                                    'border-radius': '50%',
                                    'box-shadow': '0 0 15px rgba(0, 243, 255, 0.6)'
                                })
                                .appendTo($('body'));

                            var easing = $.easing.easeInOutExpo ? 'easeInOutExpo' : 'swing';
                            imgClone.animate({
                                'top': cart.offset().top - 10,
                                'left': cart.offset().left - 10,
                                'width': 20,
                                'height': 20,
                                'opacity': 0.1
                            }, 1000, easing, function () {
                                $(this).detach();
                                var b = $('#cartCountBadge');
                                b.addClass('cart-badge-bounce');
                                setTimeout(function() {
                                    b.removeClass('cart-badge-bounce');
                                }, 600);
                            });
                        }
                    }
                }

                NotificationHelper.ShowSuccess("Laptop added to cart successfully!");
            } else {
                NotificationHelper.ShowError("Could not add item to cart.");
            }
        }, function() {
            NotificationHelper.ShowError("Connection error while adding to cart.");
        });
    }

</script>
        

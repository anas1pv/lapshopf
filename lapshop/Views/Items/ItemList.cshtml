@section Styles
{
    <link href="~/custom/css/pagination.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
}

@section Scripts
{
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <script src="~/custom/js/pagination.js"></script>
    <script src="~/Modules/Items.js" asp-append-version="true"></script>
    <script>
        var initialSearch = '@Html.Raw(ViewBag.Search)';
        var initialCategoryId = '@(ViewBag.CategoryId ?? 0)';
        ClsItems.GetAll(initialSearch, initialCategoryId);

        // Initialize Price Range Slider
        $('#price-slider').slider({
            range: true,
            min: 50,
            max: 10000,
            values: [50, 10000],
            step: 50,
            slide: function(event, ui) {
                $('#price-min-label').text(ui.values[0].toLocaleString());
                $('#price-max-label').text(ui.values[1].toLocaleString());
            },
            change: function(event, ui) {
                ClsItems.RefreshPagination();
            }
        });
    </script>
}


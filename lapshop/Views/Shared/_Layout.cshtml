<script>
    $(document).ready(function() {
        if (!sessionStorage.getItem('lapshop_notice_viewed')) {
            var modal = $('#hostingNoticeModal');
            var content = modal.find('.hosting-notice-content');
            
            modal.css('display', 'flex');
            setTimeout(function() {
                modal.css('opacity', '1');
                content.css('transform', 'scale(1)');
            }, 100);
            
            $('#closeNoticeBtn').on('click', function() {
                modal.css('opacity', '0');
                content.css('transform', 'scale(0.9)');
                setTimeout(function() {
                    modal.css('display', 'none');
                    sessionStorage.setItem('lapshop_notice_viewed', 'true');
                }, 400);
            });
        }
    });
</script>
        

@inject SignInManager<ApplicationUser> sinInManager
@inject lapshop.Bl.ISettings settingsService
@{
    var websiteSettings = settingsService.GetAll();
}
<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="LapShop — Your premium destination for laptops. Browse our wide selection of gaming, business, and ultrabook laptops from top brands.">
    <meta name="theme-color" content="#0a0a1a">
    <title>@(ViewBag.Title ?? "LapShop") | Premium Laptop Store</title>
    <link rel="icon" href="~/Fontend/images/favicon/1.png" type="image/x-icon">
    <link rel="shortcut icon" href="~/Fontend/images/favicon/1.png" type="image/x-icon">

    <!--Google font-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" type="text/css" href="~/Fontend/css/fontawesome.css">

    <!--Slick slider css-->
    <link rel="stylesheet" type="text/css" href="~/Fontend/css/slick.css">
    <link rel="stylesheet" type="text/css" href="~/Fontend/css/slick-theme.css">

    <!-- Animate icon -->
    <link rel="stylesheet" type="text/css" href="~/Fontend/css/animate.css">

    <!-- Themify icon -->
    <link rel="stylesheet" type="text/css" href="~/Fontend/css/themify-icons.css">

    <!-- Bootstrap css -->
    <link rel="stylesheet" type="text/css" href="~/Fontend/css/bootstrap.css">

    <!-- Theme css -->
    <link rel="stylesheet" type="text/css" href="~/Fontend/css/color19.css" media="screen" id="color">

    <!-- Custom Tech CSS -->
    <link rel="stylesheet" type="text/css" href="~/Fontend/css/custom-tech.css" asp-append-version="true">

    @RenderSection("Styles", required: false)
</head>

<body>
    <!-- Preloader -->
    <div id="preloader" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #0a0a0c; z-index: 999999; display: flex; flex-direction: column; align-items: center; justify-content: center; transition: opacity 0.5s ease, visibility 0.5s ease;">
        <div style="text-align: center;">
            <div class="preloader-logo" style="font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 42px; letter-spacing: 2px; color: #00f3ff; text-shadow: 0 0 20px rgba(0, 243, 255, 0.6); margin-bottom: 20px; animation: preloaderPulse 1.8s infinite ease-in-out;">LapShop</div>
            <div style="width: 140px; height: 3px; background: rgba(255,255,255,0.05); border-radius: 3px; margin: 0 auto; overflow: hidden; position: relative;">
                <div style="position: absolute; top: 0; left: 0; height: 100%; width: 50px; background: linear-gradient(90deg, transparent, #00f3ff, transparent); animation: preloaderProgress 1.5s infinite linear;"></div>
            </div>
        </div>
    </div>
    <script>
        window.addEventListener('load', function () {
            var loader = document.getElementById('preloader');
            if (loader) {
                loader.style.opacity = '0';
                loader.style.visibility = 'hidden';
                setTimeout(function() {
                    loader.remove();
                }, 500);
            }
        });
    </script>

    <!-- Promo Banner -->
    <div id="promoBanner" class="promo-banner" style="display: none; background: linear-gradient(90deg, #002244 0%, #00f3ff 50%, #002244 100%); background-size: 200% auto; animation: promoGradient 5s ease infinite; color: #000000; padding: 10px 40px 10px 20px; text-align: center; position: relative; font-size: 13px; font-weight: 700; z-index: 999; font-family: 'Outfit', sans-serif; border-bottom: 1px solid rgba(0,243,255,0.3); box-shadow: 0 4px 15px rgba(0,243,255,0.15);">
        <span style="letter-spacing: 0.5px;">🔥 Summer Sale — Up to 40% Off All Laptops! <a href="/Items/ItemList" style="color: #000000; text-decoration: underline; margin-left: 5px; font-weight: 800;">Shop Now →</a></span>
        <button onclick="closePromoBanner()" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); background: none; border: none; font-size: 16px; color: #000000; cursor: pointer; padding: 5px; line-height: 1; transition: transform 0.2s;" onmouseenter="this.style.transform='translateY(-50%) scale(1.15)'" onmouseleave="this.style.transform='translateY(-50%) scale(1)'">✕</button>
    </div>
    <script>
        if (!sessionStorage.getItem('lapshop_promo_closed')) {
            document.getElementById('promoBanner').style.display = 'block';
        }
        function closePromoBanner() {
            var banner = document.getElementById('promoBanner');
            if (banner) {
                banner.style.display = 'none';
                sessionStorage.setItem('lapshop_promo_closed', 'true');
            }
        }
    </script>

    <!-- header start -->
    <header class="header-tools marketplace">
        <div class="mobile-fix-option"></div>
        <div class="container-fluid custom-container">
            <div class="row">
                <div class="col-sm-12">
                    <div class="main-menu">
                        <div class="menu-left">
                            <div class="navbar">
                                <a href="javascript:void(0)" onclick="openNav()">
                                    <div class="bar-style">
                                        <i class="fa fa-bars sidebar-bar" aria-hidden="true"></i>
                                    </div>
                                </a>
                                <div id="mySidenav" class="sidenav">
                                    <a href="javascript:void(0)" class="sidebar-overlay" onclick="closeNav()"></a>
                                    <nav>
                                        <div onclick="closeNav()">
                                            <div class="sidebar-back text-left">
                                                <i class="fa fa-angle-left pr-2" aria-hidden="true"></i> Back
                                            </div>
                                        </div>
                                        <ul id="sub-menu" class="sm pixelstrap sm-vertical">
                                            <li>
                                                <a href="/Home/Index">Home</a>
                                            </li>
                                            <li>
                                                <a href="/Items/ItemList">Products</a>
                                            </li>
                                            <li>
                                                <a href="/Pages/AboutUs">About Us</a>
                                            </li>
                                            <li><a href="/Pages/TermsOfUse">Terms Of Use</a></li>
                                            <li>
                                                <a href="/Pages/ContactUs">Contact Us</a>
                                            </li>
                                        </ul>
                                    </nav>
                                </div>
                            </div>
                            <div class="brand-logo" style="padding: 10px 0;">
                                <a href="/Home/Index" style="text-decoration: none;">
                                    <span style="font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 28px; letter-spacing: 1px; color: #00f3ff; text-shadow: 0 0 10px rgba(0, 243, 255, 0.5);">LapShop</span>
                                </a>
                            </div>
                        </div>
                        <div class="menu-right pull-right">
                            <div>
                                <nav id="main-nav">
                                    <div class="toggle-nav"><i class="fa fa-bars sidebar-bar"></i></div>
                                    <ul id="main-menu" class="sm pixelstrap sm-horizontal">
                                        <li>
                                            <div class="mobile-back text-right">
                                                Back<i class="fa fa-angle-right pl-2" aria-hidden="true"></i>
                                            </div>
                                        </li>
                                        <li>
                                            <a href="/Home/Index">Home</a>
                                        </li>
                                        <li>
                                            <a href="/Items/ItemList">Products</a>
                                        </li>
                                        <li id="hover-cls">
                                            <a asp-controller="Pages" asp-action="AboutUs">
                                                About Us
                                            </a>
                                        </li>
                                        <li>
                                            <a asp-controller="Pages" asp-action="TermsOfUse">
                                                Terms Of Use
                                            </a>
                                        </li>
                                        <li>
                                            <a asp-controller="Pages" asp-action="ContactUs">Contact Us</a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                            <!-- Header icons -->
                            <ul class="header-dropdown" style="display: flex; align-items: center; gap: 22px; list-style: none; margin: 0 0 0 20px; padding: 0;">
                                <!-- Search -->
                                <li>
                                    <a href="javascript:void(0)" onclick="openSearch()" style="color: #94A3B8; font-size: 14px; font-weight: 500; text-decoration: none; transition: color 0.3s ease;">
                                        <i class="fa fa-search" aria-hidden="true" style="margin-right: 5px; color: #00f3ff; text-shadow: 0 0 8px rgba(0, 243, 255, 0.4);"></i> Search
                                    </a>
                                </li>
                                <!-- Wishlist -->
                                <li style="position: relative;">
                                    <a href="/Order/Wishlist" style="color: #94A3B8; font-size: 14px; font-weight: 500; text-decoration: none; transition: color 0.3s ease;">
                                        <i class="fa fa-heart" aria-hidden="true" style="margin-right: 5px; color: #00f3ff; text-shadow: 0 0 8px rgba(0, 243, 255, 0.4);"></i> Wishlist
                                        <span id="wishlistCountBadge" class="badge bg-primary" style="display: none; position: absolute; top: -8px; right: -12px; background: #00f3ff !important; color: #000000 !important; font-size: 9px; padding: 3px 5px; border-radius: 50%; font-weight: 700; line-height: 1; box-shadow: 0 0 8px rgba(0, 243, 255, 0.6);">0</span>
                                    </a>
                                </li>
                                <!-- Cart -->
                                <li style="position: relative;">
                                    <a href="/Order/Cart" style="color: #94A3B8; font-size: 14px; font-weight: 500; text-decoration: none; transition: color 0.3s ease;">
                                        <i class="fa fa-shopping-cart" aria-hidden="true" style="margin-right: 5px; color: #00f3ff; text-shadow: 0 0 8px rgba(0, 243, 255, 0.4);"></i> Cart
                                        @{
                                            int cartCount = 0;
                                            string cartCookies = Context.Request.Cookies["Cart"];
                                            if (!string.IsNullOrEmpty(cartCookies))
                                            {
                                                try
                                                {
                                                    var layoutCart = Newtonsoft.Json.JsonConvert.DeserializeObject<ShoppingCart>(cartCookies);
                                                    if (layoutCart != null && layoutCart.lstItems != null)
                                                    {
                                                        cartCount = layoutCart.lstItems.Sum(x => (int)x.Qty);
                                                    }
                                                }
                                                catch {}
                                            }
                                        }
                                        @if (cartCount > 0)
                                        {
                                            <span id="cartCountBadge" class="badge bg-primary" style="position: absolute; top: -8px; right: -12px; background: #00f3ff !important; color: #000000 !important; font-size: 9px; padding: 3px 5px; border-radius: 50%; font-weight: 700; line-height: 1; box-shadow: 0 0 8px rgba(0, 243, 255, 0.6);">@cartCount</span>
                                        }
                                        else
                                        {
                                            <span id="cartCountBadge" class="badge bg-primary" style="display: none; position: absolute; top: -8px; right: -12px; background: #00f3ff !important; color: #000000 !important; font-size: 9px; padding: 3px 5px; border-radius: 50%; font-weight: 700; line-height: 1; box-shadow: 0 0 8px rgba(0, 243, 255, 0.6);">0</span>
                                        }
                                    </a>
                                </li>
                                <!-- My Account (click-based) -->
                                <li id="accountDropdown" style="position: relative;">
                                    <a href="javascript:void(0)" onclick="toggleAccountMenu()" style="color: #94A3B8; font-size: 14px; font-weight: 500; text-decoration: none; transition: color 0.3s ease;">
                                        <i class="fa fa-user" aria-hidden="true" style="margin-right: 5px; color: #00f3ff; text-shadow: 0 0 8px rgba(0, 243, 255, 0.4);"></i> My Account <i class="fa fa-chevron-down" style="font-size: 10px; margin-left: 3px;"></i>
                                    </a>
                                    <ul id="accountMenu" style="display: none; position: absolute; right: 0; top: 100%; margin-top: 10px; background: var(--bg-secondary, #10102a); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; box-shadow: 0 15px 40px rgba(0,0,0,0.5); backdrop-filter: blur(20px); min-width: 200px; padding: 8px 0; z-index: 1000; list-style: none;">
                                        @if (sinInManager.IsSignedIn(User))
                                        {
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <li>
                                                    <a href="/admin/Home" style="display: block; padding: 10px 20px; color: #00f3ff !important; font-weight: 600; font-size: 13px; transition: all 0.2s;"><i class="fa fa-tachometer" style="width: 20px; margin-right: 8px;"></i>Admin Dashboard</a>
                                                </li>
                                            }
                                            <li>
                                                <a asp-controller="Users" asp-action="AccountDetails" style="display: block; padding: 10px 20px; font-size: 13px; transition: all 0.2s;"><i class="fa fa-cog" style="width: 20px; margin-right: 8px;"></i>Account Settings</a>
                                            </li>
                                            <li>
                                                <a asp-controller="Order" asp-action="MyOrders" style="display: block; padding: 10px 20px; font-size: 13px; transition: all 0.2s;"><i class="fa fa-shopping-bag" style="width: 20px; margin-right: 8px;"></i>My Orders</a>
                                            </li>
                                            <li style="border-top: 1px solid rgba(255,255,255,0.06); margin-top: 5px; padding-top: 5px;">
                                                <a asp-controller="Users" asp-action="LoginOut" style="display: block; padding: 10px 20px; color: #EF4444 !important; font-size: 13px; transition: all 0.2s;"><i class="fa fa-sign-out" style="width: 20px; margin-right: 8px;"></i>Logout</a>
                                            </li>
                                        }
                                        else
                                        {
                                            <li><a asp-controller="Users" asp-action="Login" style="display: block; padding: 10px 20px; font-size: 13px;"><i class="fa fa-sign-in" style="width: 20px; margin-right: 8px;"></i>Login</a></li>
                                            <li><a asp-controller="Users" asp-action="Register" style="display: block; padding: 10px 20px; font-size: 13px;"><i class="fa fa-user-plus" style="width: 20px; margin-right: 8px;"></i>Register</a></li>
                                        }
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    @RenderBody()

    <!-- footer -->

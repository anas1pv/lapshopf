@model lapshop.Models.AccountDetailsViewModel
@{
    ViewBag.Title = "Account Details";
}

<div class="breadcrumb-section">
    <div class="container">
        <div class="row">
            <div class="col-sm-6">
                <div class="page-title">
                    <h2>My Account</h2>
                </div>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb" class="theme-breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/Home/Index">Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Account</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<section class="section-b-space">
    <div class="container">
        <div class="row" style="justify-content: center; margin-bottom: 30px;">
            <div class="col-lg-12">
                <div style="text-align: center; margin-bottom: 30px;">
                    <div style="width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, #00f3ff, #00a2ff); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; box-shadow: 0 0 30px rgba(0,243,255,0.3);">
                        <i class="fa fa-user" style="font-size: 32px; color: #fff;"></i>
                    </div>
                    <h3 style="color: #F1F5F9; font-size: 26px; font-weight: 700; margin-bottom: 5px;">My Account</h3>
                    <p style="color: #64748B; font-size: 14px;">Manage your account settings</p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-6">
                <div class="dashboard-box" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 30px; margin-bottom: 30px;">
                    <h4 style="color: #F1F5F9; margin-bottom: 20px;">Update Profile</h4>
                    @if (TempData["ProfileSuccess"] != null)
                    {
                        <div class="alert alert-success">@TempData["ProfileSuccess"]</div>
                    }
                    @if (TempData["ProfileError"] != null)
                    {
                        <div class="alert alert-danger">@TempData["ProfileError"]</div>
                    }

                    <form class="theme-form" asp-action="UpdateProfile" asp-controller="Users" method="post">
                        <div class="form-row row">
                            <div class="col-md-6 mb-3">
                                <label for="FirstName" style="color: #94A3B8;">First Name</label>
                                <input type="text" class="form-control" asp-for="FirstName" style="background-color: rgba(255,255,255,0.05); color: #F1F5F9; border-color: rgba(255,255,255,0.1);">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="LastName" style="color: #94A3B8;">Last Name</label>
                                <input type="text" class="form-control" asp-for="LastName" style="background-color: rgba(255,255,255,0.05); color: #F1F5F9; border-color: rgba(255,255,255,0.1);">
                            </div>
                            <div class="col-md-12 mb-3">
                                <label for="Email" style="color: #94A3B8;">Email Address</label>
                                <input type="email" class="form-control" asp-for="Email" style="background-color: rgba(255,255,255,0.05); color: #F1F5F9; border-color: rgba(255,255,255,0.1);">
                            </div>
                        </div>
                        <button class="btn btn-solid" style="background: var(--gradient-button); border: none; color: #000 !important;" type="submit">Save Changes</button>
                    </form>
                </div>
            </div>
            
            <div class="col-lg-6">
                <div class="dashboard-box" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 30px; margin-bottom: 30px;">
                    <h4 style="color: #F1F5F9; margin-bottom: 20px;">Change Password</h4>
                    @if (TempData["PasswordSuccess"] != null)
                    {
                        <div class="alert alert-success">@TempData["PasswordSuccess"]</div>
                    }
                    @if (TempData["PasswordError"] != null)
                    {
                        <div class="alert alert-danger">@TempData["PasswordError"]</div>
                    }

                    <form class="theme-form" asp-action="ChangePassword" asp-controller="Users" method="post">
                        <div class="form-row row">
                            <div class="col-md-12 mb-3">
                                <label for="CurrentPassword" style="color: #94A3B8;">Current Password</label>
                                <input type="password" class="form-control" name="CurrentPassword" id="CurrentPassword" required style="background-color: rgba(255,255,255,0.05); color: #F1F5F9; border-color: rgba(255,255,255,0.1);">
                            </div>
                            <div class="col-md-12 mb-3">
                                <label for="NewPassword" style="color: #94A3B8;">New Password</label>
                                <input type="password" class="form-control" name="NewPassword" id="NewPassword" required style="background-color: rgba(255,255,255,0.05); color: #F1F5F9; border-color: rgba(255,255,255,0.1);">
                            </div>
                            <div class="col-md-12 mb-3">
                                <label for="ConfirmPassword" style="color: #94A3B8;">Confirm Password</label>
                                <input type="password" class="form-control" name="ConfirmPassword" id="ConfirmPassword" required style="background-color: rgba(255,255,255,0.05); color: #F1F5F9; border-color: rgba(255,255,255,0.1);">
                            </div>
                        </div>
                        <button class="btn btn-solid" style="background-color: #EF4444; border-color: #EF4444;" type="submit">Update Password</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12 text-center mt-3">
                <a asp-controller="Users" asp-action="LoginOut" class="btn btn-solid" style="background-color: #333; border-color: #333;"><i class="fa fa-sign-out"></i> Logout</a>
            </div>
        </div>
    </div>
</section>

                    <div style="width: 70px; height: 70px; background: linear-gradient(135deg, rgba(0,243,255,0.15), rgba(0,162,255,0.1)); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">

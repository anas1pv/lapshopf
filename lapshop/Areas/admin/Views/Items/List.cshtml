 @model List<lapshop.Domains.VwItem>
@inject SignInManager<ApplicationUser> _SignInManager; 
@inject UserManager<ApplicationUser> _UserManager;
@section Styles
    {
    <!-- Plugin css for this page -->
    <link rel="stylesheet" href="~/assets/Backend/vendors/datatables.net-bs4/dataTables.bootstrap4.css">
    <!-- End plugin css for this page -->
}


<div class="content-wrapper">
    <div class="page-header">
        <h3 class="page-title"> Items Management </h3>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin/Home">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Items</li>
            </ol>
        </nav>
    </div>
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Items List</h4>
            <div class="row mb-4">
                <div class="col-md-8">
                    <div class="form-group d-flex flex-wrap gap-3 align-items-center">
                        <div>
                            <label for="categoryFilter" class="me-2" style="font-size: 13px; color: #94A3B8;">Filter by Category:</label>
                            <select id="categoryFilter" class="form-control d-inline-block w-auto" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #F1F5F9; border-radius: 8px;"
                                    asp-items="@(new SelectList(ViewBag.lstCategories,"CategoryId","CategoryName"))"
                                    onchange="Search(this)">
                                <option value="">Select Category</option>
                            </select>
                        </div>
                        <div>
                            <label for="itemTypeFilter" class="me-2" style="font-size: 13px; color: #94A3B8;">Filter by Type:</label>
                            <select id="itemTypeFilter" class="form-control d-inline-block w-auto" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #F1F5F9; border-radius: 8px;"
                                    asp-items="@(new SelectList(ViewBag.lstItemTypes,"ItemTypeId","ItemTypeName"))"
                                    onchange="Search(this)">
                                <option value="">Select Type</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-md-end">
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Admin/Items/Edit" class="btn btn-gradient-primary btn-fw">
                            <i class="mdi mdi-plus"></i> New Item
                        </a>
                    }
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="table-responsive">
                        <table id="order-listing" class="table table-hover">
                            <thead>
                                <tr>
                                    <th style="color: #86868b; font-weight: 600; font-size: 12px; border: none; padding: 12px;">@ResAdmin.lblImage</th>
                                    <th style="color: #86868b; font-weight: 600; font-size: 12px; border: none; padding: 12px;">@ResAdmin.lblItemName</th>
                                    <th style="color: #86868b; font-weight: 600; font-size: 12px; border: none; padding: 12px;">@ResAdmin.lblCategoryName</th>
                                    <th style="color: #86868b; font-weight: 600; font-size: 12px; border: none; padding: 12px;">@ResAdmin.lblItemType</th>
                                    <th style="color: #86868b; font-weight: 600; font-size: 12px; border: none; padding: 12px;">@ResAdmin.lblPrice</th>
                                    <th style="color: #86868b; font-weight: 600; font-size: 12px; border: none; padding: 12px;">@ResGeneral.lblActions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cat in Model)
                                {
                                    <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.04);">
                                        <td style="border: none; padding: 12px;">
                                            <img src="/Uploads/Items/@cat.ImageName" style="width:50px; height:50px; border-radius:5px;" />
                                        </td>
                                        <td style="color: #ffffff; font-weight: 500; font-size: 13px; border: none; padding: 12px;">@cat.ItemName</td>
                                        <td style="color: #86868b; font-size: 13px; border: none; padding: 12px;">@cat.CategoryName</td>
                                        <td style="color: #86868b; font-size: 13px; border: none; padding: 12px;">@cat.ItemTypeName</td>
                                        <td style="color: #10B981; font-weight: 600; font-size: 13px; border: none; padding: 12px;">$@cat.SalesPrice</td>

                                        <td style="border: none; padding: 12px; white-space: nowrap;">
                                            <a asp-controller="Items" asp-action="Edit" asp-route-itemId="@cat.ItemId"
                                               class="btn btn-info btn-sm" style="padding: 6px 12px; font-size: 12px; border-radius: 6px; margin-right: 5px;">Edit</a>

                                            <a asp-controller="Items" asp-action="Delete" asp-route-itemId="@cat.ItemId"
                                               class="btn btn-danger btn-sm" style="padding: 6px 12px; font-size: 12px; border-radius: 6px;"
                                               onclick="return confirm('Are you sure?');">Delete</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
    {
    <!-- Plugin js for this page -->
    <script src="~/Admin/vendors/datatables.net/jquery.dataTables.js"></script>
    <script src="~/Admin/vendors/datatables.net-bs4/dataTables.bootstrap4.js"></script>
    <!-- End plugin js for this page -->
    <!-- Custom js for this page -->
    <script src="~/Admin/js/data-table.js"></script>
    <!-- End custom js for this page -->

    <script>
        function Search(dropDown) {
            var id = $(dropDown).val();
            if (id) {
                window.location.href = "/admin/Items/Search?id=" + id;
            } else {
                window.location.href = "/admin/Items/List";
            }
        }
    </script>
}



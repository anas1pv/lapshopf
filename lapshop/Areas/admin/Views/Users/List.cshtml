@model IEnumerable<lapshop.Areas.admin.Controllers.UserViewModel>
@{
    ViewData["Title"] = "Users Management";
    var allRoles = ViewBag.AllRoles as List<string> ?? new List<string>();
    var searchTerm = ViewBag.Search as string ?? "";
}

<div class="content-wrapper">
    <div class="page-header">
        <h3 class="page-title">
            <span class="page-title-icon bg-gradient-primary text-white me-2">
                <i class="mdi mdi-account-group"></i>
            </span> Users Management
        </h3>
        <nav aria-label="breadcrumb">
            <ul class="breadcrumb">
                <li class="breadcrumb-item active" aria-current="page">
                    <span></span>@Model.Count() users total
                </li>
            </ul>
        </nav>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert" style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3); color: #10B981; border-radius: 12px; margin-bottom: 20px;">
            <i class="mdi mdi-check-circle me-2"></i>@TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert" style="background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.3); color: #EF4444; border-radius: 12px; margin-bottom: 20px;">
            <i class="mdi mdi-alert-circle me-2"></i>@TempData["Error"]
        </div>
    }

    <!-- Search Bar -->
    <div class="row mb-4">
        <div class="col-md-6">
            <form method="get" asp-action="List" class="d-flex" style="gap: 10px;">
                <input type="text" name="search" value="@searchTerm" class="form-control" placeholder="Search by email, first name or last name..." 
                       style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); color: #F1F5F9; border-radius: 10px; padding: 10px 16px;" />
                <button type="submit" class="btn btn-gradient-primary" style="border-radius: 10px; padding: 10px 20px; white-space: nowrap;">
                    <i class="mdi mdi-magnify"></i> Search
                </button>
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <a href="/admin/Users/List" class="btn btn-outline-secondary" style="border-radius: 10px; padding: 10px 16px; white-space: nowrap; color: #94A3B8 !important; border-color: rgba(255,255,255,0.15);">
                        <i class="mdi mdi-close"></i> Clear
                    </a>
                }
            </form>
        </div>
    </div>

    <div class="row">
        <div class="col-12 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">
                        @if (!string.IsNullOrEmpty(searchTerm))
                        {
                            <span>Results for "<strong>@searchTerm</strong>"</span>
                        }
                        else
                        {
                            <span>All Registered Users</span>
                        }
                    </h4>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th style="width: 30%;"> Email </th>
                                    <th style="width: 15%;"> First Name </th>
                                    <th style="width: 15%;"> Last Name </th>
                                    <th style="width: 20%;"> Roles </th>
                                    <th style="width: 20%;"> Actions </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model)
                                {
                                    <tr>
                                        <td>
                                            <div style="display: flex; align-items: center; gap: 10px;">
                                                <div style="width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, #00f3ff, #00a2ff); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                                    <i class="mdi mdi-account" style="color: #fff; font-size: 16px;"></i>
                                                </div>
                                                <span style="color: #F1F5F9;">@user.Email</span>
                                            </div>
                                        </td>
                                        <td>@user.FirstName</td>
                                        <td>@user.LastName</td>
                                        <td>
                                            @foreach (var role in user.Roles)
                                            {
                                                if (role == "Admin")
                                                {
                                                    <span class="badge" style="background: linear-gradient(135deg, #EF4444, #DC2626); color: #fff; padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 600;">@role</span>
                                                }
                                                else
                                                {
                                                    <span class="badge" style="background: linear-gradient(135deg, #00f3ff, #00a2ff); color: #000; padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 600;">@role</span>
                                                }
                                            }
                                        </td>
                                        <td>
                                            @if (user.Email != "admin@lapshop.com")
                                            {
                                                <button type="button" class="btn btn-sm" style="background: rgba(0,243,255,0.15); color: #00e5ff; border: 1px solid rgba(0,243,255,0.3); border-radius: 8px; padding: 5px 12px; font-size: 12px; transition: all 0.2s;" 
                                                        onclick="openRoleModal('@user.Id', '@user.Email', '@string.Join(",", user.Roles)')">
                                                    <i class="mdi mdi-account-edit"></i> Roles
                                                </button>
                                                <form asp-action="DeleteUser" method="post" style="display: inline-block;" onsubmit="return confirm('Are you sure you want to delete @user.Email?');">
                                                    <input type="hidden" name="userId" value="@user.Id" />
                                                    <button type="submit" class="btn btn-sm" style="background: rgba(239,68,68,0.12); color: #EF4444; border: 1px solid rgba(239,68,68,0.3); border-radius: 8px; padding: 5px 12px; font-size: 12px; transition: all 0.2s;">
                                                        <i class="mdi mdi-delete"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span style="color: #64748B; font-size: 12px;"><i class="mdi mdi-shield-lock"></i> Protected</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Role Edit Modal -->
<div id="roleModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.7); z-index:99999; backdrop-filter:blur(5px);">
    <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); background:#0F0F2A; border:1px solid rgba(0,243,255,0.25); border-radius:16px; padding:30px; width:400px; max-width:90%; box-shadow:0 25px 60px rgba(0,0,0,0.5);">
        <h5 style="color:#F1F5F9; margin-bottom:5px; font-family:'Outfit',sans-serif;">Edit Roles</h5>
        <p id="roleModalEmail" style="color:#64748B; font-size:13px; margin-bottom:20px;"></p>
        <form id="roleForm" asp-action="UpdateRoles" method="post">
            <input type="hidden" name="userId" id="roleModalUserId" />
            @foreach (var role in allRoles)
            {
                <div style="margin-bottom:12px; display:flex; align-items:center; gap:10px;">
                    <input type="checkbox" name="roles" value="@role" id="role_@role"
                           style="width:18px; height:18px; accent-color:#00f3ff; cursor:pointer;" />
                    <label for="role_@role" style="color:#F1F5F9; font-size:14px; cursor:pointer; margin:0;">@role</label>
                </div>
            }
            <div style="display:flex; gap:10px; margin-top:24px;">
                <button type="submit" class="btn btn-gradient-primary" style="border-radius:10px; flex:1;">Save Roles</button>
                <button type="button" class="btn" onclick="closeRoleModal()" style="background:rgba(255,255,255,0.06); color:#94A3B8; border:1px solid rgba(255,255,255,0.1); border-radius:10px; flex:1;">Cancel</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function openRoleModal(userId, email, currentRoles) {
        document.getElementById('roleModalUserId').value = userId;
        document.getElementById('roleModalEmail').textContent = email;

        // Uncheck all
        var checkboxes = document.querySelectorAll('#roleForm input[type=checkbox]');
        checkboxes.forEach(function(cb) { cb.checked = false; });

        // Check current roles
        var roles = currentRoles.split(',');
        roles.forEach(function(role) {
            var cb = document.getElementById('role_' + role.trim());
            if (cb) cb.checked = true;
        });

        document.getElementById('roleModal').style.display = 'block';
    }

    function closeRoleModal() {
        document.getElementById('roleModal').style.display = 'none';
    }

    // Close on backdrop click
    document.getElementById('roleModal').addEventListener('click', function(e) {
        if (e.target === this) closeRoleModal();
    });

    // Close on Escape
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeRoleModal();
    });
</script>
}

@model lapshop.Domains.TbCoupon
@{
    ViewData["Title"] = Model.CouponId == 0 ? "Create Coupon" : "Edit Coupon";
}

<div class="content-wrapper">
    <div class="page-header">
        <h3 class="page-title" style="color: #ffffff; font-family: 'Outfit', sans-serif; font-weight: 700;">
            @(Model.CouponId == 0 ? "Create Coupon" : "Edit Coupon")
        </h3>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin/Home">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="/admin/Coupons/List">Coupons</a></li>
                <li class="breadcrumb-item active" aria-current="page">@(Model.CouponId == 0 ? "New" : "Edit")</li>
            </ol>
        </nav>
    </div>

    <div class="row">
        <div class="col-md-6 grid-margin stretch-card">
            <div class="card" style="background: #161617; border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; width: 100%;">
                <div class="card-body" style="padding: 25px;">
                    <h4 style="color: #ffffff; font-family: 'Outfit', sans-serif; font-size: 16px; font-weight: 600; margin-bottom: 5px;">Coupon Details</h4>
                    <p style="color: #94a3b8; font-size: 13px; margin-bottom: 25px;">Define coupon code rules and discount percentages</p>

                    <form class="forms-sample" asp-controller="Coupons" asp-action="Save" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="CouponId" />

                        <div class="form-group mb-3">
                            <label asp-for="CouponCode" style="color: #ffffff; font-weight: 500; font-size: 13px; margin-bottom: 6px; display: block;">Coupon Code</label>
                            <input asp-for="CouponCode" class="form-control" placeholder="e.g. WELCOME10" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); color: #fff; border-radius: 8px; padding: 10px 14px; text-transform: uppercase;" />
                            <span asp-validation-for="CouponCode" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="DiscountPercent" style="color: #ffffff; font-weight: 500; font-size: 13px; margin-bottom: 6px; display: block;">Discount Percentage (%)</label>
                            <input asp-for="DiscountPercent" type="number" min="1" max="100" class="form-control" placeholder="e.g. 15" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); color: #fff; border-radius: 8px; padding: 10px 14px;" />
                            <span asp-validation-for="DiscountPercent" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="ExpiryDate" style="color: #ffffff; font-weight: 500; font-size: 13px; margin-bottom: 6px; display: block;">Expiry Date</label>
                            <input asp-for="ExpiryDate" type="date" class="form-control" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); color: #fff; border-radius: 8px; padding: 10px 14px;" value="@Model.ExpiryDate.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-4" style="padding-left: 0;">
                            <div class="custom-control custom-checkbox" style="display: flex; align-items: center; gap: 8px;">
                                <input asp-for="IsActive" type="checkbox" class="filter-checkbox" id="coupon-active" style="width: 18px; height: 18px; accent-color: #00f3ff; cursor: pointer;" />
                                <label class="form-check-label" for="coupon-active" style="color: #ffffff; font-size: 14px; cursor: pointer; margin: 0;">Is Active / Enabled</label>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-gradient-primary me-2" style="padding: 12px 24px; font-weight: 600; border-radius: 8px; font-size: 13px;">Save Coupon</button>
                            <a href="/admin/Coupons/List" class="btn btn-light" style="padding: 12px 24px; font-weight: 600; border-radius: 8px; font-size: 13px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.1); color: #fff;">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@model List<lapshop.Domains.TbCategory>
@{
}

@section Styles
{
<!-- Plugin css for this page -->
<link rel="stylesheet" href="~/assets/Backend/vendors/datatables.net-bs4/dataTables.bootstrap4.css">
<!-- End plugin css for this page -->
}


<div class="content-wrapper">
    <div class="page-header">
        <h3 class="page-title"> Categories </h3>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin/Home">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Categories</li>
            </ol>
        </nav>
    </div>
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Categories List</h4>
                <div class="col-12">
                     <a href="/Admin/Categories/Edit" class="btn btn-gradient-primary btn-fw mb-3">
                          <i class="mdi mdi-plus"></i> New Category
                      </a>
                    <div class="table-responsive">
                        <table id="order-listing" class="table table-hover">
                            <thead>
                                <tr>
                                    <th style="color: #86868b; font-weight: 600; font-size: 12px; border: none; padding: 12px;"> Image </th>
                                    <th style="color: #86868b; font-weight: 600; font-size: 12px; border: none; padding: 12px;"> Category Name </th>
                                    <th style="color: #86868b; font-weight: 600; font-size: 12px; border: none; padding: 12px;"> Actions </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cat in Model)
                                {
                                    <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.04);">
                                        <td style="border: none; padding: 12px;">
                                            <img src="/Uploads/Categories/@cat.ImageName"
                                                 style="width:50px; height:50px; border-radius:5px;"
                                                 alt="@cat.CategoryName" />
                                        </td>
                                        <td style="color: #ffffff; font-weight: 500; font-size: 13px; border: none; padding: 12px;">@cat.CategoryName</td>
                                        <td style="border: none; padding: 12px; white-space: nowrap;"> 
                                            <a asp-controller="Categories" asp-action="Edit" asp-route-categoryId="@cat.CategoryId"
                                               class="btn btn-info btn-sm" style="padding: 6px 12px; font-size: 12px; border-radius: 6px; margin-right: 5px;">Edit</a>

                                            <a asp-controller="Categories" asp-action="Delete" asp-route-categoryId="@cat.CategoryId"
                                               class="btn btn-danger btn-sm" style="padding: 6px 12px; font-size: 12px; border-radius: 6px;"
                                               onclick="return confirm('Are you sure you want to delete this category?');">Delete</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
        </div>
    </div>
</div>

@section Scripts
{
<!-- Plugin js for this page -->
<script src="~/Admin/vendors/datatables.net/jquery.dataTables.js"></script>
<script src="~/Admin/vendors/datatables.net-bs4/dataTables.bootstrap4.js"></script>
<!-- End plugin js for this page -->
<!-- Custom js for this page -->
<script src="~/Admin/js/data-table.js"></script>
<!-- End custom js for this page -->
}



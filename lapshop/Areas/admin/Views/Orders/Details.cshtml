@model lapshop.Domains.TbSalesInvoice
@{
    var customerName = ViewBag.CustomerName as string ?? "Unknown Customer";
    var customerEmail = ViewBag.CustomerEmail as string ?? "N/A";
    var customerPhone = ViewBag.CustomerPhone as string ?? "N/A";
    var total = Model.TbSalesInvoiceItems.Sum(x => x.InvoicePrice * (decimal)x.Qty);
}

<div class="content-wrapper">
    <div class="page-header">
        <h3 class="page-title"> Order Details </h3>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin/Home">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="/admin/Orders/List">Orders</a></li>
                <li class="breadcrumb-item active" aria-current="page">#@Model.InvoiceId</li>
            </ol>
        </nav>
    </div>

    <div class="row">
        <!-- Order info & customer info -->
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="card-title"><i class="mdi mdi-information-outline text-primary me-2"></i> Order Summary</h4>
                    <ul class="list-unstyled mt-3" style="line-height: 2;">
                        <li><strong>Invoice ID:</strong> #@Model.InvoiceId</li>
                        <li><strong>Order Date:</strong> @Model.InvoiceDate.ToString("yyyy-MM-dd hh:mm tt")</li>
                        <li><strong>Estimated Delivery:</strong> @Model.DelivryDate.ToString("yyyy-MM-dd")</li>
                        <li><strong>Total Amount:</strong> <span class="text-success font-weight-bold" style="font-size: 16px;">$@total.ToString("N2")</span></li>
                        <li><strong>Notes:</strong> @(string.IsNullOrEmpty(Model.Notes) ? "No special instructions." : Model.Notes)</li>
                    </ul>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="card-title"><i class="mdi mdi-account-outline text-primary me-2"></i> Customer Info</h4>
                    <ul class="list-unstyled mt-3" style="line-height: 2;">
                        <li><strong>Name:</strong> @customerName</li>
                        <li><strong>Email:</strong> @customerEmail</li>
                        <li><strong>Phone:</strong> @customerPhone</li>
                    </ul>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h4 class="card-title"><i class="mdi mdi-update text-primary me-2"></i> Update Order Status</h4>
                    <form asp-controller="Orders" asp-action="UpdateStatus" method="post" class="mt-3">
                        <input type="hidden" name="id" value="@Model.InvoiceId" />
                        <div class="form-group">
                            <label for="status" class="mb-2">Select Order Status:</label>
                            <select name="status" class="form-control" style="background-color: #1e1e1f; border-color: rgba(255,255,255,0.1); color: #fff;">
                                <option value="1" selected="@(Model.CurrentState == 1 ? "selected" : null)">Pending</option>
                                <option value="2" selected="@(Model.CurrentState == 2 ? "selected" : null)">Shipped</option>
                                <option value="3" selected="@(Model.CurrentState == 3 ? "selected" : null)">Delivered</option>
                                <option value="4" selected="@(Model.CurrentState == 4 ? "selected" : null)">Canceled</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-gradient-primary btn-fw w-100 mt-2">Update Status</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Order Items -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title"><i class="mdi mdi-laptop text-primary me-2"></i> Ordered Items</h4>
                    <div class="table-responsive mt-3">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th> Image </th>
                                    <th> Product Name </th>
                                    <th> Unit Price </th>
                                    <th> Quantity </th>
                                    <th> Subtotal </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.TbSalesInvoiceItems)
                                {
                                    var subtotal = item.InvoicePrice * (decimal)item.Qty;
                                    <tr>
                                        <td>
                                            <img src="/Uploads/Items/@item.Item.ImageName" style="width: 50px; height: 50px; border-radius: 5px;" alt="@item.Item.ItemName" />
                                        </td>
                                        <td>@item.Item.ItemName</td>
                                        <td>$@item.InvoicePrice.ToString("N2")</td>
                                        <td>@item.Qty</td>
                                        <td>$@subtotal.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-4">
                        <a href="/admin/Orders/List" class="btn btn-light"><i class="mdi mdi-arrow-left"></i> Back to Orders</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
